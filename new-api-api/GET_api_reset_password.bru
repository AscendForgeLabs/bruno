meta {
  name: GET /api/reset_password
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/api/reset_password?email={{email}}
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

tests {
  test("status is not server error", function() {
    expect(res.status).to.be.lessThan(500);
  });
}
