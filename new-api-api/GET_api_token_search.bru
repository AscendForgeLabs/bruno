meta {
  name: GET /api/token/search
  type: http
  seq: 111
}

get {
  url: {{baseUrl}}/api/token/search?keyword={{keyword}}
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

tests {
  test("status is not server error", function() {
    expect(res.status).to.be.lessThan(500);
  });
}
