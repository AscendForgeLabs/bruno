meta {
  name: GET /api/log/token
  type: http
  seq: 130
}

get {
  url: {{baseUrl}}/api/log/token?key={{key}}
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

tests {
  test("status is not server error", function() {
    expect(res.status).to.be.lessThan(500);
  });
}
