meta {
  name: GET /api/user/search
  type: http
  seq: 59
}

get {
  url: {{baseUrl}}/api/user/search?keyword={{keyword}}&group={{group}}
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

tests {
  test("status is not server error", function() {
    expect(res.status).to.be.lessThan(500);
  });
}
