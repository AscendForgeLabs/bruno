meta {
  name: GET /api/log/
  type: http
  seq: 123
}

get {
  url: {{baseUrl}}/api/log/?p={{p}}&page_size={{page_size}}
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

tests {
  test("status is not server error", function() {
    expect(res.status).to.be.lessThan(500);
  });
}
